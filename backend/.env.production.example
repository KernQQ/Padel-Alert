NODE_ENV=production
PORT=3000

# Managed PostgreSQL in production:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PG_SSL=true
PG_POOL_MAX=10

# Exact public origins, comma-separated. No trailing slash.
ALLOWED_ORIGINS=https://app.twojadomena.pl
FRONTEND_URL=https://app.twojadomena.pl

TRUST_PROXY=true
SESSION_DAYS=30
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=12
MAX_JSON_SIZE=256kb
